---
import data from "../assets/data/projects.json"
import { Icon } from 'astro-icon/components';

---
<div class="mt-20 " id="projects">
    <div>
        <h1 class="md:text-[76px] text-[43px] titulo text-white" >Proyectos</h1>
        <p class="texto text-xl">Estos son algunos proyectos que he realizado a lo largo de mi aprendizaje: </p>
    </div>
    <div class="md:flex md:mt-20 md:flex-col ">
        {
            data.map(({title,description,Tech,github,img})=>(
                <div class="md:flex mt-20 md:gap-x-5 scroll">
                    {/* imagen */}
                    <div class="md:flex-6/12 p-10">
                    <img src={img} alt="projecto" class="rounder-xl">
                    </div>
                    <div class="md:flex-6/12 flex flex-col texto  gap-y-5 mt-10 ">
                        <h1 class="text-4xl font-medium text-white">{title}</h1>
                        <p class="text-lg">{description}</p>
                        <p class="text-2xl font-medium text-white">Tecnologias:</p>  
                        <div class="flex gap-4">
                            { Tech.map((data)=> 
                                Object.entries(data).map((x)=> <Icon name={x[1]} title={x[0]} class="h-10 w-10" >↗</Icon>
                                )
                              )
                            }
                        </div>
                        <a href={github} class=" underline text-[var(--Botones)]">Ver en GitHub. <Icon name="line-md:github" class="inline text-2xl">↗</Icon></a>
                    </div>
                </div>
            ))
        }
    </div>
</div>