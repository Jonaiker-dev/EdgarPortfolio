---

<Layout>
	<Welcome />
	<hr class="mt-30 text-[#484848] xl:-mx-[90px] 2xl:-mx-[210px] -mx-4 w-screen ">
	<Projects />
	<hr class="mt-30 text-[#484848] xl:-mx-[90px] 2xl:-mx-[210px] -mx-4 w-screen ">
	<About  />
	<hr class="mt-30 text-[#484848] xl:-mx-[90px] 2xl:-mx-[210px] -mx-4 w-screen ">
	<Contact/>
</Layout>
